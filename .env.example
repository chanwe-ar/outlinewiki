# outlinewiki (CHANWE's fork of outline/outline) — the variables CHANWE's deployment sets.
# Every other Outline variable, with its meaning and default, is in the upstream
# sample `.env.sample` (kept untouched) and https://docs.getoutline.com/s/hosting.
# Real values: the home server's stack .env (chanwe-proxmox-server stacks/outline) and
# chanwe-locker. Names and placeholders only here; never commit a real value.

# --- Core ---
# Public URL of the wiki; required.
URL=https://wiki.chanwe.ar
# Port inside the container; the server stack sets 3000.
PORT=3000
# Runtime mode; production in deployment.
NODE_ENV=production
# Session/cookie signing key, 64 hex chars; required. # secret
SECRET_KEY=
# Key for internal utility endpoints (cron); required. # secret
UTILS_SECRET=
# Redirect HTTP to HTTPS; optional.
FORCE_HTTPS=
# Check getoutline.com for updates; optional.
ENABLE_UPDATES=
# Web worker processes; optional.
WEB_CONCURRENCY=
# Default UI language; optional.
DEFAULT_LANGUAGE=
# Log level; optional.
LOG_LEVEL=

# --- Database and cache ---
# PostgreSQL connection string; required. # secret
DATABASE_URL=postgres://outline:password@localhost:5432/outline
# PostgreSQL SSL mode; optional.
PGSSLMODE=
# Redis connection string; required. # secret
REDIS_URL=redis://localhost:6379

# --- File storage (the server stack sets these in compose.yml) ---
# "local" stores uploads on disk.
FILE_STORAGE=local
# Folder for local uploads inside the container.
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
# Max upload size in bytes; optional.
FILE_STORAGE_UPLOAD_MAX_SIZE=
# Max import size in bytes; optional.
FILE_STORAGE_IMPORT_MAX_SIZE=

# --- Sign-in through CHANWE Identity (OIDC) ---
# OIDC client id registered on Identity; required.
OIDC_CLIENT_ID=
# OIDC client secret; required. # secret
OIDC_CLIENT_SECRET=
# Identity issuer; also used by CHANWE's patch (docker/oidc-identity-profile.cjs) to fetch the signing keys.
OIDC_ISSUER_URL=https://identity.chanwe.ar
# Authorization endpoint; required.
OIDC_AUTH_URI=https://identity.chanwe.ar/authorize
# Token endpoint; required.
OIDC_TOKEN_URI=https://identity.chanwe.ar/token
# Userinfo endpoint; required.
OIDC_USERINFO_URI=https://identity.chanwe.ar/userinfo
# Logout endpoint; optional.
OIDC_LOGOUT_URI=
# Scopes requested; optional.
OIDC_SCOPES=
# Claim used as the username; optional.
OIDC_USERNAME_CLAIM=
# Label on the sign-in button; optional.
OIDC_DISPLAY_NAME=
# CHANWE patch: audience the access token must carry; optional (default chanwe-wiki-api).
OIDC_ACCESS_TOKEN_AUDIENCE=chanwe-wiki-api
# CHANWE patch: scope the access token must grant; optional (default wiki:access).
OIDC_REQUIRED_SCOPE=wiki:access

# --- Slack integration ---
# Slack app id; optional.
SLACK_APP_ID=
# Slack OAuth client id; optional.
SLACK_CLIENT_ID=
# Slack OAuth client secret; optional. # secret
SLACK_CLIENT_SECRET=
# Slack request verification token; optional. # secret
SLACK_VERIFICATION_TOKEN=
# Enable Slack message actions; optional.
SLACK_MESSAGE_ACTIONS=

# --- Rate limiting ---
# Enable the rate limiter; optional.
RATE_LIMITER_ENABLED=
# Requests allowed per window; optional.
RATE_LIMITER_REQUESTS=
# Window length in seconds; optional.
RATE_LIMITER_DURATION_WINDOW=

# --- Carried over from the Railway environment (not read by Outline's own code) ---
# Silences the AWS SDK v2 maintenance notice; optional.
AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=
# Railway private-network flag; unused on the home server.
ENABLE_ALPINE_PRIVATE_NETWORKING=
